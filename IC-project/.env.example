POSTGRES_USER=ic_tender
POSTGRES_PASSWORD=ic_tender_dev_only
POSTGRES_DB=ic_tender
DATABASE_URL=postgres://ic_tender:ic_tender_dev_only@localhost:5432/ic_tender?sslmode=disable
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
# development | production. In production the API refuses to start with sslmode=disable, a non-https WEB_ORIGIN or empty secrets.
APP_ENV=development
# At least 32 characters, different from each other. Generate with: openssl rand -hex 32
SESSION_SECRET=
INTERNAL_JOB_SECRET=
# true only when the API is reachable exclusively through the Next.js proxy (it appends the client address).
# With false every user behind the proxy shares one address, so the per-address login limit would apply to everybody together.
TRUST_FORWARDED_FOR=true
